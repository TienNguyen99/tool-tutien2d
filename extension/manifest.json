{
  "manifest_version": 3,
  "name": "Tiên Lộ Trợ Thủ",
  "version": "1.3.54",
  "permissions": ["activeTab"],
  "action": {"default_title":"Cho phép AI đọc ảnh hội thoại của tab game này"},
  "incognito": "split",
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {"service_worker":"background.js"},
  "description": "Kết nối dữ liệu Tu Tiên 2D với trợ thủ cục bộ qua runtime PNTT.",
  "content_scripts": [
    {"matches":["https://tutien2d.online/*"],"js":["local-bridge.js"],"run_at":"document_start","world":"ISOLATED"},
    {
      "matches": ["https://tutien2d.online/*"],
      "js": ["local-client.js", "clone-login.js", "decision-policy.js", "utility-policy.js", "session-metrics.js", "quest-workflow.js", "hook.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
